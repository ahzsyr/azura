// Marketing integrations platform models

model MarketingProviderRuntime {
  id               String   @id @default(cuid())
  providerId       String   @unique @db.VarChar(64)
  enabled          Boolean  @default(true)
  installedVersion String   @default("1.0.0") @db.VarChar(32)
  lifecycle        String   @default("discovered") @db.VarChar(32)
  maintenanceMode  Boolean  @default(false)
  lastSyncAt       DateTime?
  healthSummary    String?  @db.Text
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connections MarketingConnection[]
  jobs        MarketingJob[]
  syncStates  MarketingSyncState[]
  telemetry   MarketingTelemetry[]
}

model MarketingConnection {
  id            String   @id @default(cuid())
  providerId    String   @db.VarChar(64)
  runtime       MarketingProviderRuntime @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  tenantId      String   @default("default") @db.VarChar(64)
  status        String   @default("disconnected") @db.VarChar(32)
  lifecycle     String   @default("configured") @db.VarChar(32)
  oauthMetadata Json     @default("{}")
  scopesGranted Json     @default("[]")
  scopesRequired Json    @default("[]")
  scopesMissing Json     @default("[]")
  scopesExpired Json     @default("[]")
  lastHealthAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  credential MarketingCredential?
  accounts   MarketingAccount[]
  jobs       MarketingJob[]

  @@unique([providerId, tenantId])
  @@index([status])
  @@index([lifecycle])
}

model MarketingCredential {
  id             String   @id @default(cuid())
  connectionId   String   @unique
  connection     MarketingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accessToken    String   @db.Text
  refreshToken   String?  @db.Text
  tokenType      String?  @db.VarChar(32)
  expiresAt      DateTime?
  refreshStatus  String   @default("ok") @db.VarChar(32)
  sealedPayload  Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MarketingAccount {
  id               String   @id @default(cuid())
  connectionId     String
  connection       MarketingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalAccountId String  @db.VarChar(128)
  accountType      String   @db.VarChar(64)
  displayName      String   @db.VarChar(256)
  metadata         Json     @default("{}")
  isSelected       Boolean  @default(false)
  healthSummary    String?  @db.Text
  currency         String?  @db.VarChar(8)
  spend            Float    @default(0)
  impressions      Float    @default(0)
  clicks           Float    @default(0)
  conversions      Float    @default(0)
  lastSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assets MarketingAsset[]
  jobs   MarketingJob[]
  providerBindings MarketingCampaignProviderBinding[]
  externalCampaigns MarketingExternalCampaign[]

  @@unique([connectionId, externalAccountId])
  @@index([accountType])
}

model MarketingAsset {
  id                 String   @id @default(cuid())
  accountId          String
  account            MarketingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  canonicalAssetKind String   @db.VarChar(64)
  providerAssetType  String   @db.VarChar(64)
  externalAssetId    String   @db.VarChar(128)
  displayName        String   @db.VarChar(256)
  metadata           Json     @default("{}")
  selectable         Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([accountId, externalAssetId])
  @@index([canonicalAssetKind])
}

model MarketingPermissionState {
  id            String   @id @default(cuid())
  providerId    String   @db.VarChar(64)
  connectionId  String   @db.VarChar(64)
  entries       Json     @default("[]")
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([providerId, connectionId])
  @@index([lastCheckedAt])
}

model MarketingSyncState {
  id                 String              @id @default(cuid())
  providerId         String              @db.VarChar(64)
  runtime            MarketingProviderRuntime @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  entity             String              @db.VarChar(64)
  entityId           String?             @db.VarChar(128)
  lastSuccessfulSync DateTime?
  lastAttempt        DateTime?
  nextScheduled      DateTime?
  status             MarketingSyncStatus @default(IDLE)
  failureReason      String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([providerId, entity, entityId])
  @@index([status, nextScheduled])
}

model MarketingJob {
  id              String             @id @default(cuid())
  providerId      String?            @db.VarChar(64)
  runtime         MarketingProviderRuntime? @relation(fields: [providerId], references: [providerId], onDelete: SetNull)
  connectionId    String?
  connection      MarketingConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  accountId       String?
  account         MarketingAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  jobType         String             @db.VarChar(64)
  workflowStage   String             @default("queued") @db.VarChar(64)
  payload         Json               @default("{}")
  result          Json               @default("{}")
  idempotencyKey  String             @unique @db.VarChar(191)
  status          MarketingJobStatus @default(PENDING)
  attemptCount    Int                @default(0)
  maxAttempts     Int                @default(5)
  lastError       String?            @db.Text
  scheduledAt     DateTime           @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, scheduledAt])
  @@index([jobType, status])
  @@index([providerId, status])
}

model MarketingWebhookEvent {
  id               String                 @id @default(cuid())
  providerId       String                 @db.VarChar(64)
  eventType        String                 @db.VarChar(128)
  externalEventId  String?                @db.VarChar(191)
  signatureValid   Boolean                @default(false)
  status           MarketingWebhookStatus @default(RECEIVED)
  rawPayload       Json                   @default("{}")
  normalizedPayload Json                  @default("{}")
  processingError  String?                @db.Text
  attemptCount     Int                    @default(0)
  receivedAt       DateTime               @default(now())
  processedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([providerId, status])
  @@index([externalEventId])
  @@unique([providerId, externalEventId])
}

model MarketingAnalyticsSnapshot {
  id          String   @id @default(cuid())
  providerId  String   @db.VarChar(64)
  accountId   String   @db.VarChar(128)
  metric      String   @db.VarChar(64)
  value       Float    @default(0)
  periodStart DateTime
  periodEnd   DateTime
  dimensions  Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([providerId, accountId, metric, periodStart, periodEnd])
  @@index([providerId, periodStart])
  @@index([metric, periodStart])
}

model MarketingProviderAppConfig {
  id                 String   @id @default(cuid())
  providerId         String   @unique @db.VarChar(64)
  clientId           String?  @db.VarChar(256)
  clientSecret       String?  @db.Text
  appSecret          String?  @db.Text
  webhookVerifyToken String?  @db.Text
  pixelId            String?  @db.VarChar(128)
  capiAccessToken    String?  @db.Text
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MarketingTrackingConfig {
  id             String   @id @default(cuid())
  providerId     String   @unique @db.VarChar(64)
  enabled        Boolean  @default(false)
  pixelId        String?  @db.VarChar(128)
  capiEnabled    Boolean  @default(false)
  accessToken    String?  @db.Text
  testEventCode  String?  @db.VarChar(128)
  mappings       Json     @default("{}")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MarketingLeadEvent {
  id              String   @id @default(cuid())
  providerId      String   @db.VarChar(64)
  externalLeadId  String   @db.VarChar(191)
  formId          String?  @db.VarChar(128)
  payload         Json     @default("{}")
  canonical       Json     @default("{}")
  inquiryId       String?  @db.VarChar(64)
  processingStatus String  @default("pending") @db.VarChar(32)
  idempotencyKey  String   @unique @db.VarChar(191)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerId, externalLeadId])
  @@index([processingStatus])
}

model MarketingTelemetry {
  id             String   @id @default(cuid())
  providerId     String   @db.VarChar(64)
  runtime        MarketingProviderRuntime @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  operation      String   @db.VarChar(128)
  durationMs     Int      @default(0)
  retryCount     Int      @default(0)
  rateLimited    Boolean  @default(false)
  queueWaitMs    Int?
  outcome        String   @db.VarChar(16)
  errorCategory  String?  @db.VarChar(64)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([outcome, createdAt])
}

// --- Campaign intelligence (first-party marketing platform) ---

model MarketingSource {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  label       String   @db.VarChar(128)
  category    String   @default("other") @db.VarChar(32)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  touches     MarketingTouch[]
  events      MarketingEvent[]
  conversions MarketingConversion[]
  leadAttributions MarketingLeadAttribution[]
}

model MarketingCampaign {
  id                String                  @id @default(cuid())
  internalId        String                  @unique @db.VarChar(64)
  name              String                  @db.VarChar(256)
  objective         String?                 @db.VarChar(128)
  channel           String?                 @db.VarChar(64)
  status            MarketingCampaignStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  budget            Float?
  budgetCurrency    String?                 @db.VarChar(8)
  targetAudience    String?                 @db.Text
  targetLocation    String?                 @db.VarChar(256)
  landingPagePath   String?                 @db.VarChar(512)
  conversionGoalId  String?
  conversionGoal    MarketingConversionDefinition? @relation(fields: [conversionGoalId], references: [id], onDelete: SetNull)
  description       String?                 @db.Text
  notes             String?                 @db.Text
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  providerBindings MarketingCampaignProviderBinding[]
  trackingUrls     MarketingTrackingUrl[]
  touches          MarketingTouch[]
  events           MarketingEvent[]
  conversions      MarketingConversion[]
  leadAttributions MarketingLeadAttribution[]
  metricRollups    MarketingMetricRollup[]

  @@index([status])
  @@index([startDate, endDate])
}

model MarketingCampaignProviderBinding {
  id                   String   @id @default(cuid())
  campaignId           String
  campaign             MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  providerId           String   @db.VarChar(64)
  adAccountId          String?
  adAccount            MarketingAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  externalCampaignId   String?  @db.VarChar(128)
  externalCampaignName String?  @db.VarChar(256)
  status               String   @default("linked") @db.VarChar(32)
  syncStatus           String   @default("idle") @db.VarChar(32)
  lastSyncAt           DateTime?
  providerMetadata     Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  externalCampaigns MarketingExternalCampaign[]
  trackingUrls      MarketingTrackingUrl[]

  @@unique([campaignId, providerId, externalCampaignId])
  @@index([providerId])
  @@index([adAccountId])
}

model MarketingExternalCampaign {
  id                 String   @id @default(cuid())
  providerId         String   @db.VarChar(64)
  externalId         String   @db.VarChar(128)
  providerEntityType String   @default("campaign") @db.VarChar(64)
  name               String   @db.VarChar(256)
  status             String   @default("unknown") @db.VarChar(32)
  adAccountId        String?
  adAccount          MarketingAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  providerBindingId  String?
  providerBinding    MarketingCampaignProviderBinding? @relation(fields: [providerBindingId], references: [id], onDelete: SetNull)
  providerMetadata   Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  adGroups MarketingAdGroup[]

  @@unique([providerId, externalId])
  @@index([adAccountId])
  @@index([providerBindingId])
}

model MarketingAdGroup {
  id                   String   @id @default(cuid())
  providerId           String   @db.VarChar(64)
  externalId           String   @db.VarChar(128)
  providerEntityType   String   @default("ad_group") @db.VarChar(64)
  name                 String   @db.VarChar(256)
  status               String   @default("unknown") @db.VarChar(32)
  externalCampaignId   String
  externalCampaign     MarketingExternalCampaign @relation(fields: [externalCampaignId], references: [id], onDelete: Cascade)
  providerMetadata     Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ads MarketingAd[]

  @@unique([providerId, externalId])
  @@index([externalCampaignId])
}

model MarketingAd {
  id                 String   @id @default(cuid())
  providerId         String   @db.VarChar(64)
  externalId         String   @db.VarChar(128)
  providerEntityType String   @default("ad") @db.VarChar(64)
  name               String   @db.VarChar(256)
  status             String   @default("unknown") @db.VarChar(32)
  adGroupId          String
  adGroup            MarketingAdGroup @relation(fields: [adGroupId], references: [id], onDelete: Cascade)
  providerMetadata   Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  creatives MarketingCreative[]
  trackingUrls MarketingTrackingUrl[]
  touches   MarketingTouch[]
  conversions MarketingConversion[]

  @@unique([providerId, externalId])
  @@index([adGroupId])
}

model MarketingCreative {
  id                 String   @id @default(cuid())
  providerId         String   @db.VarChar(64)
  externalId         String   @db.VarChar(128)
  providerEntityType String   @default("creative") @db.VarChar(64)
  name               String?  @db.VarChar(256)
  creativeType       String?  @db.VarChar(64)
  headline           String?  @db.VarChar(512)
  body               String?  @db.Text
  previewUrl         String?  @db.Text
  adId               String
  ad                 MarketingAd @relation(fields: [adId], references: [id], onDelete: Cascade)
  providerMetadata   Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([providerId, externalId])
  @@index([adId])
}

model MarketingTrackingUrl {
  id                String   @id @default(cuid())
  campaignId        String
  campaign          MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  providerBindingId String?
  providerBinding   MarketingCampaignProviderBinding? @relation(fields: [providerBindingId], references: [id], onDelete: SetNull)
  externalAdId      String?
  externalAd        MarketingAd? @relation(fields: [externalAdId], references: [id], onDelete: SetNull)
  baseUrl           String   @db.Text
  utmSource         String?  @db.VarChar(128)
  utmMedium         String?  @db.VarChar(128)
  utmCampaign       String?  @db.VarChar(256)
  utmContent        String?  @db.VarChar(256)
  utmTerm           String?  @db.VarChar(256)
  fullUrl           String   @db.Text
  qrAssetRef        String?  @db.Text
  label             String?  @db.VarChar(256)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([campaignId])
  @@index([utmCampaign])
}

model MarketingVisitor {
  id               String                 @id @default(cuid())
  visitorToken     String                 @unique @db.VarChar(64)
  consentStatus    MarketingConsentStatus @default(UNKNOWN)
  consentGrantedAt DateTime?
  firstSeenAt      DateTime               @default(now())
  lastSeenAt       DateTime               @default(now())
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  sessions    MarketingSession[]
  touches     MarketingTouch[]
  events      MarketingEvent[]
  conversions MarketingConversion[]
}

model MarketingSession {
  id              String    @id @default(cuid())
  visitorId       String
  visitor         MarketingVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionToken    String    @unique @db.VarChar(64)
  entryUrl        String?   @db.Text
  landingPagePath String?   @db.VarChar(512)
  referrer        String?   @db.Text
  deviceType      String?   @db.VarChar(32)
  browser         String?   @db.VarChar(64)
  os              String?   @db.VarChar(64)
  country         String?   @db.VarChar(64)
  region          String?   @db.VarChar(64)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  touches     MarketingTouch[]
  events      MarketingEvent[]
  conversions MarketingConversion[]

  @@index([visitorId, startedAt])
}

model MarketingTouch {
  id                 String               @id @default(cuid())
  visitorId          String
  visitor            MarketingVisitor     @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  sessionId          String
  session            MarketingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceId           String?
  source             MarketingSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  medium             String?              @db.VarChar(64)
  internalCampaignId String?
  internalCampaign   MarketingCampaign?   @relation(fields: [internalCampaignId], references: [id], onDelete: SetNull)
  externalAdId       String?
  externalAd         MarketingAd?         @relation(fields: [externalAdId], references: [id], onDelete: SetNull)
  landingPagePath    String?              @db.VarChar(512)
  referrer           String?              @db.Text
  utmSource          String?              @db.VarChar(128)
  utmMedium          String?              @db.VarChar(128)
  utmCampaign        String?              @db.VarChar(256)
  utmContent         String?              @db.VarChar(256)
  utmTerm            String?              @db.VarChar(256)
  touchType          MarketingTouchType   @default(DIRECT)
  clickIdType        MarketingClickIdType?
  clickId            String?              @db.VarChar(256)
  occurredAt         DateTime             @default(now())
  providerMetadata   Json                 @default("{}")
  rawPayload         Json                 @default("{}")
  createdAt          DateTime             @default(now())

  events      MarketingEvent[]
  conversions MarketingConversion[]
  leadFirstTouches MarketingLeadAttribution[] @relation("LeadFirstTouch")
  leadLastTouches  MarketingLeadAttribution[] @relation("LeadLastTouch")

  @@index([visitorId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([sourceId])
  @@index([internalCampaignId])
  @@index([touchType])
}

model MarketingEvent {
  id                 String   @id @default(cuid())
  eventId            String?  @db.VarChar(128)
  idempotencyKey     String   @unique @db.VarChar(191)
  visitorId          String?
  visitor            MarketingVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  sessionId          String?
  session            MarketingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  touchId            String?
  touch              MarketingTouch? @relation(fields: [touchId], references: [id], onDelete: SetNull)
  name               String   @db.VarChar(128)
  properties         Json     @default("{}")
  internalCampaignId String?
  internalCampaign   MarketingCampaign? @relation(fields: [internalCampaignId], references: [id], onDelete: SetNull)
  landingPagePath    String?  @db.VarChar(512)
  sourceId           String?
  source             MarketingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  medium             String?  @db.VarChar(64)
  clientOccurredAt   DateTime
  serverReceivedAt   DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([name, clientOccurredAt])
  @@index([visitorId, clientOccurredAt])
  @@index([internalCampaignId])
  @@index([sourceId])
}

model MarketingConversionDefinition {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.Text
  triggerType String   @db.VarChar(64)
  triggerConfig Json   @default("{}")
  value       Float?
  currency    String?  @db.VarChar(8)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   MarketingCampaign[]
  conversions MarketingConversion[]
}

model MarketingConversion {
  id                     String   @id @default(cuid())
  idempotencyKey         String   @unique @db.VarChar(191)
  visitorId              String?
  visitor                MarketingVisitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  sessionId              String?
  session                MarketingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  touchId                String?
  touch                  MarketingTouch? @relation(fields: [touchId], references: [id], onDelete: SetNull)
  internalCampaignId     String?
  internalCampaign       MarketingCampaign? @relation(fields: [internalCampaignId], references: [id], onDelete: SetNull)
  externalAdId           String?
  externalAd             MarketingAd? @relation(fields: [externalAdId], references: [id], onDelete: SetNull)
  landingPagePath        String?  @db.VarChar(512)
  sourceId               String?
  source                 MarketingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  leadId                 String?  @db.VarChar(64)
  submissionId           String?  @db.VarChar(64)
  conversionDefinitionId String
  conversionDefinition   MarketingConversionDefinition @relation(fields: [conversionDefinitionId], references: [id], onDelete: Cascade)
  clientOccurredAt       DateTime
  serverReceivedAt       DateTime @default(now())
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now())

  @@index([conversionDefinitionId, clientOccurredAt])
  @@index([internalCampaignId])
  @@index([sourceId])
  @@index([leadId])
  @@index([submissionId])
}

model MarketingLeadAttribution {
  id                 String   @id @default(cuid())
  submissionId       String?  @db.VarChar(64)
  inquiryId          String?  @db.VarChar(64)
  leadEventId        String?
  visitorId          String?  @db.VarChar(64)
  sessionId          String?  @db.VarChar(64)
  firstTouchId       String?
  firstTouch         MarketingTouch? @relation("LeadFirstTouch", fields: [firstTouchId], references: [id], onDelete: SetNull)
  lastTouchId        String?
  lastTouch          MarketingTouch? @relation("LeadLastTouch", fields: [lastTouchId], references: [id], onDelete: SetNull)
  sourceId           String?
  source             MarketingSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  internalCampaignId String?
  internalCampaign   MarketingCampaign? @relation(fields: [internalCampaignId], references: [id], onDelete: SetNull)
  externalAdId       String?  @db.VarChar(64)
  landingPagePath    String?  @db.VarChar(512)
  utmSource          String?  @db.VarChar(128)
  utmMedium          String?  @db.VarChar(128)
  utmCampaign        String?  @db.VarChar(256)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([submissionId])
  @@index([inquiryId])
  @@index([internalCampaignId])
  @@index([sourceId])
}

model MarketingMetricRollup {
  id                 String   @id @default(cuid())
  periodStart        DateTime
  periodEnd          DateTime
  granularity        String   @default("day") @db.VarChar(16)
  internalCampaignId String?
  internalCampaign   MarketingCampaign? @relation(fields: [internalCampaignId], references: [id], onDelete: Cascade)
  sourceId           String?  @db.VarChar(64)
  providerId         String?  @db.VarChar(64)
  landingPagePath    String?  @db.VarChar(512)
  conversionType     String?  @db.VarChar(64)
  trafficType        String?  @db.VarChar(32)
  visitors           Int      @default(0)
  sessions           Int      @default(0)
  pageViews          Int      @default(0)
  leads              Int      @default(0)
  conversions        Int      @default(0)
  spend              Float    @default(0)
  impressions        Float    @default(0)
  clicks             Float    @default(0)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([periodStart, periodEnd, granularity, internalCampaignId, sourceId, providerId, landingPagePath, conversionType, trafficType])
  @@index([periodStart, granularity])
  @@index([internalCampaignId, periodStart])
}

model MarketingAutomationRule {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(256)
  enabled     Boolean  @default(true)
  triggerType String   @db.VarChar(64)
  conditions  Json     @default("{}")
  actions     Json     @default("[]")
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions MarketingAutomationExecution[]

  @@index([enabled, triggerType])
}

model MarketingAutomationExecution {
  id        String   @id @default(cuid())
  ruleId    String
  rule      MarketingAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status    String   @db.VarChar(32)
  payload   Json     @default("{}")
  result    Json     @default("{}")
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([ruleId, createdAt])
}

model MarketingRetentionPolicy {
  id                    String   @id @default(cuid())
  visitorDays           Int      @default(365)
  sessionDays           Int      @default(180)
  touchDays             Int      @default(365)
  eventDays             Int      @default(365)
  leadDays              Int      @default(730)
  providerPayloadDays   Int      @default(90)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
